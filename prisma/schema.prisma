generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model PlayerStats {
  id              String   @id @default("singleton")
  totalHands      Int      @default(0)
  handsWon        Int      @default(0)
  handsLost       Int      @default(0)
  handsFolded     Int      @default(0)
  totalProfit     Int      @default(0)
  biggestPot      Int      @default(0)
  biggestWin      Int      @default(0)
  vpipHands       Int      @default(0)
  pfrHands        Int      @default(0)
  advisorFollowed Int      @default(0)
  advisorShown    Int      @default(0)
  sessionsPlayed  Int      @default(0)
  updatedAt       DateTime @updatedAt
}

model Session {
  id          String    @id @default(cuid())
  startedAt   DateTime  @default(now())
  endedAt     DateTime?
  mode        String
  handsPlayed Int       @default(0)
  profit      Int       @default(0)
  finalStack  Int       @default(10000)
  startStack  Int       @default(10000)
  hands       Hand[]
}

model Hand {
  id              String   @id @default(cuid())
  sessionId       String
  session         Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  handNumber      Int
  holeCards       String
  communityCards  String
  position        String
  actions         String
  result          String
  profitLoss      Int
  potSize         Int
  handStrength    String?
  advisorAction   String?
  playerAction    String
  followedAdvisor Boolean  @default(false)
  createdAt       DateTime @default(now())
}
