generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  username     String       @unique
  passwordHash String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  stats        PlayerStats?
  sessions     Session[]
}

model PlayerStats {
  id                   String   @id @default(cuid())
  userId               String?  @unique
  user                 User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  totalHands           Int      @default(0)
  handsWon             Int      @default(0)
  handsLost            Int      @default(0)
  handsFolded          Int      @default(0)
  totalProfit          Int      @default(0)
  biggestPot           Int      @default(0)
  biggestWin           Int      @default(0)
  vpipHands            Int      @default(0)
  pfrHands             Int      @default(0)
  advisorFollowed      Int      @default(0)
  advisorShown         Int      @default(0)
  sessionsPlayed       Int      @default(0)
  correctDecisions     Int      @default(0)
  totalDecisions       Int      @default(0)
  totalPlaytimeSeconds Int      @default(0)
  quizAnswered         Int      @default(0)
  quizCorrect          Int      @default(0)
  quizPlaytimeSeconds  Int      @default(0)
  updatedAt            DateTime @updatedAt
}

model Session {
  id              String    @id @default(cuid())
  userId          String?
  user            User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  startedAt       DateTime  @default(now())
  endedAt         DateTime?
  mode            String
  handsPlayed     Int       @default(0)
  profit          Int       @default(0)
  finalStack      Int       @default(10000)
  startStack      Int       @default(10000)
  savedState      String?
  playtimeSeconds Int       @default(0)
  hands           Hand[]
}

model Hand {
  id              String   @id @default(cuid())
  sessionId       String
  session         Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  handNumber      Int
  holeCards       String
  communityCards  String
  position        String
  actions         String
  result          String
  profitLoss      Int
  potSize         Int
  handStrength    String?
  advisorAction   String?
  playerAction    String
  followedAdvisor Boolean  @default(false)
  createdAt       DateTime @default(now())
}
